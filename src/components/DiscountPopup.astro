---
import Icon from "./Icon.astro";
import { home } from "../content/home";
import { site } from "../content/site";

const { discountPopup } = home;
---

<div class="discount-popup" data-discount-popup hidden>
  <div class="discount-popup__backdrop" data-discount-close></div>
  <div
    class="discount-popup__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="discount-title"
  >
    <button class="discount-popup__close" type="button" aria-label="Chiudi" data-discount-close>
      <Icon name="close" />
    </button>
    <div class="discount-popup__media">
      <img src={discountPopup.image} alt="" loading="lazy" />
    </div>
    <div class="discount-popup__body">
      <img class="discount-popup__logo" src={site.logoFull} alt={site.name} width="150" height="90" />
      <h2 id="discount-title" set:html={discountPopup.titleHtml} />
      <p>{discountPopup.text}</p>
      <form
        class="discount-popup__form"
        data-local-form
        data-success="Grazie! La richiesta di sconto di esempio è stata inviata."
      >
        <label class="sr-only" for="discount-email">Email</label>
        <input id="discount-email" name="email" type="email" required placeholder="Email" />
        <button class="btn btn--dark" type="submit">Invia</button>
        <p class="form-status" data-form-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</div>

<style>
  .discount-popup {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: center;
    padding: 1rem;
  }

  .discount-popup[hidden] {
    display: none;
  }

  .discount-popup__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
  }

  .discount-popup__dialog {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(100%, 800px);
    background: var(--color-white);
    box-shadow: 2px 8px 23px 3px rgba(0, 0, 0, 0.2);
  }

  .discount-popup__close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    padding: 0;
    border: 2px solid var(--color-black);
    background: var(--color-white);
    color: var(--color-black);
    cursor: pointer;
  }

  .discount-popup__close :global(svg) {
    width: 12px;
    height: 12px;
  }

  .discount-popup__media {
    display: none;
    padding: 17px 0 17px 0;
  }

  .discount-popup__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .discount-popup__body {
    padding: 40px 25px 30px;
  }

  .discount-popup__logo {
    width: 150px;
    margin: 0 auto 25px;
  }

  .discount-popup__body h2 {
    margin-bottom: 25px;
    font-size: 30px;
    font-weight: 400;
    line-height: 1;
  }

  .discount-popup__body h2 :global(strong) {
    font-weight: 700;
  }

  .discount-popup__body p {
    margin-bottom: 25px;
    font-size: 15px;
  }

  .discount-popup__form {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
  }

  .discount-popup__form input {
    min-height: 40px;
    padding: 6px 14px;
    border: 1px solid #69727d;
    border-radius: 3px;
    font-size: 15px;
  }

  .discount-popup__form .btn {
    min-height: 40px;
    padding: 0 28px;
  }

  .discount-popup__form .form-status {
    grid-column: 1 / -1;
  }

  @media (min-width: 768px) {
    .discount-popup__dialog {
      grid-template-columns: 378px 1fr;
      min-height: 513px;
    }

    .discount-popup__media {
      display: block;
    }

    .discount-popup__body {
      padding: 65px 40px 40px;
    }

    .discount-popup__body h2 {
      font-size: 36px;
    }
  }
</style>
