---
import { site } from "../content/site";
import { home } from "../content/home";

interface Props {
  title: string;
  label?: string;
  intro?: string;
  image?: string;
}

const { title, label = "A modo tuo", intro, image = home.hero.background } = Astro.props;
---

<section class="page-hero" style={`--page-hero: url(${image})`}>
  <div class="page-hero__box">
    <img class="page-hero__logo" src={site.logoMark} alt="" width="95" height="97" />
    <h5 class="page-hero__label">{label}</h5>
    <h1 class="page-hero__title">{title}</h1>
    {intro && <p class="page-hero__intro">{intro}</p>}
  </div>
</section>

<style>
  .page-hero {
    display: grid;
    place-items: center;
    padding: 80px 20px;
    background: #fff var(--page-hero) center / cover no-repeat;
    color: var(--color-white);
    text-align: center;
  }

  .page-hero__box {
    display: grid;
    justify-items: center;
    gap: 10px;
    width: min(100%, 586px);
    padding: 20px 20px 30px;
    background: #000000a3;
  }

  .page-hero__logo {
    width: 70px;
    height: auto;
  }

  .page-hero__label {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 900;
    letter-spacing: 3px;
    line-height: 1;
    text-transform: uppercase;
  }

  .page-hero__title {
    font-family: var(--font-body);
    font-size: 26px;
    font-weight: 400;
    line-height: 1;
  }

  .page-hero__intro {
    max-width: 30rem;
    margin: 6px 0 0;
    font-size: 15px;
  }

  @media (min-width: 768px) {
    .page-hero {
      padding-block: 180px;
    }

    .page-hero__box {
      gap: 14px;
      padding: 20px 30px 35px;
    }

    .page-hero__logo {
      width: 95px;
    }

    .page-hero__label {
      font-size: 50px;
      letter-spacing: 4.8px;
    }

    .page-hero__title {
      font-size: 40px;
    }
  }
</style>
