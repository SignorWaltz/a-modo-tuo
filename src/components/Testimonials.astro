---
import Icon from "./Icon.astro";
import { home } from "../content/home";
import { reviews } from "../content/reviews";

const { reviews: heading } = home;
const rating = 4.7;
const stars = Array.from({ length: 5 }, (_, i) => Math.round(Math.min(1, Math.max(0, rating - i)) * 100));
---

<section class="testimonials" aria-labelledby="reviews-title">
  <div class="container">
    <div class="testimonials__intro">
      <h6 class="section-label">{heading.label}</h6>
      <h2 class="testimonials__title" id="reviews-title">{heading.title}</h2>
      <div class="testimonials__stars" role="img" aria-label={`Valutazione ${rating} su 5`}>
        {stars.map((fill) => <span class="testimonials__star" style={`--fill: ${fill}%`}>★</span>)}
      </div>
    </div>

    <div class="testimonials__carousel">
      <button class="testimonials__nav testimonials__nav--prev" type="button" aria-label="Recensione precedente" data-carousel-prev>
        <Icon name="chevron-left" />
      </button>
      <div class="testimonials__viewport" data-carousel data-carousel-mode="single">
        <div class="testimonials__track" data-carousel-track>
          {
            reviews.map((review) => (
              <article class="testimonial-card">
                <p class="testimonial-card__text">{review.text}</p>
                <p class="testimonial-card__name">{review.name}</p>
                <p class="testimonial-card__source">{review.source}</p>
              </article>
            ))
          }
        </div>
      </div>
      <button class="testimonials__nav testimonials__nav--next" type="button" aria-label="Recensione successiva" data-carousel-next>
        <Icon name="chevron-right" />
      </button>
      <div class="testimonials__dots" data-carousel-dots aria-label="Navigazione recensioni"></div>
    </div>
  </div>
</section>

<style>
  .testimonials {
    padding-block: 10px 30px;
    background: var(--color-white);
  }

  .testimonials__intro {
    text-align: center;
  }

  .testimonials .section-label {
    font-size: 16px;
  }

  .testimonials__title {
    margin-top: 12px;
    font-size: 23px;
  }

  .testimonials__stars {
    display: inline-flex;
    gap: 2px;
    margin-top: 12px;
    font-size: 24px;
    line-height: 1;
  }

  .testimonials__star {
    color: transparent;
    background: linear-gradient(90deg, #f0ad4e var(--fill), #ccd6df var(--fill));
    -webkit-background-clip: text;
    background-clip: text;
  }

  .testimonials__carousel {
    position: relative;
    margin-top: 30px;
    padding-inline: 30px;
  }

  .testimonials__viewport {
    position: relative;
    overflow: hidden;
  }

  .testimonials__track {
    display: flex;
    transition: transform 0.5s ease;
  }

  .testimonial-card {
    flex: 0 0 100%;
    padding: 0 6px;
    text-align: center;
  }

  .testimonial-card__text {
    margin: 0 0 25px;
    font-size: 17px;
    font-style: italic;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-black);
  }

  .testimonial-card__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-black);
  }

  .testimonial-card__source {
    margin: 0;
    font-size: 14px;
    color: var(--color-gold);
  }

  .testimonials__nav {
    position: absolute;
    top: 30%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    padding: 0;
    border: 0;
    background: transparent;
    color: rgba(238, 238, 238, 0.9);
    cursor: pointer;
  }

  .testimonials__nav :global(svg) {
    width: 20px;
    height: 20px;
  }

  .testimonials__nav--prev {
    left: 0;
  }

  .testimonials__nav--next {
    right: 0;
  }

  .testimonials__dots {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 60px;
  }

  .testimonials__dots :global(button) {
    width: 6px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #000;
    opacity: 0.2;
    cursor: pointer;
  }

  .testimonials__dots :global(button.is-active) {
    opacity: 1;
  }

  @media (min-width: 768px) {
    .testimonials .section-label {
      font-size: 18px;
    }

    .testimonials__title {
      font-size: 52px;
    }

    .testimonial-card {
      padding: 0 40px;
    }
  }
</style>
