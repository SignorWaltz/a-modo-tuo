---
import { site } from "../content/site";

interface Props {
  label: string;
  title: string;
  textHtml: string;
}

const { label, title, textHtml } = Astro.props;
---

<section class="page-intro container">
  <img class="page-intro__logo" src={site.logoMark} alt="" width="177" height="181" />
  <h6 class="section-label">{label}</h6>
  <h2 class="section-title page-intro__title">{title}</h2>
  <span class="divider"></span>
  <p class="page-intro__text" set:html={textHtml} />
</section>

<style>
  .page-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding-block: 50px 20px;
  }

  .page-intro__logo {
    width: 120px;
    height: auto;
    margin-bottom: 8px;
  }

  .page-intro__title {
    font-size: 40px;
  }

  .page-intro__text {
    margin: 12px 0 0;
    font-size: 15px;
  }

  @media (min-width: 768px) {
    .page-intro__logo {
      width: 177px;
    }

    .page-intro__title {
      font-size: 68px;
    }

    .page-intro__text {
      font-size: 16px;
    }
  }
</style>
