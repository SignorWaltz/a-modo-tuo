---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PageIntro from "../components/PageIntro.astro";
import Gallery from "../components/Gallery.astro";
import { donnaGallery, donnaPage } from "../content/galleries";
---

<BaseLayout title={donnaPage.title} description={donnaPage.description}>
  <PageHero title={donnaPage.title} />
  <PageIntro {...donnaPage.intro} />
  <Gallery items={donnaGallery} />
</BaseLayout>
