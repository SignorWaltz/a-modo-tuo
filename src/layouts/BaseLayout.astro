---
import "../styles/global.css";
import UtilityBar from "../components/UtilityBar.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Newsletter from "../components/Newsletter.astro";
import Testimonials from "../components/Testimonials.astro";
import ContactMapBand from "../components/ContactMapBand.astro";
import DiscountPopup from "../components/DiscountPopup.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { site } from "../content/site";

interface Props {
  title?: string;
  description?: string;
  showSharedSections?: boolean;
  showContactBand?: boolean;
}

const {
  title = site.name,
  description = site.description,
  showSharedSections = true,
  showContactBand = true,
} = Astro.props;

const pageTitle = title.includes(site.name) ? title : `${title} - ${site.name}`;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={site.favicon} />
    <link rel="apple-touch-icon" href={site.favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,600;0,6..96,700;0,6..96,900;1,6..96,400&family=Poppins:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,400;1,700&family=Roboto:wght@500&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="sr-only" href="#contenuto">Vai al contenuto</a>
    <UtilityBar />
    <SiteHeader />
    <main id="contenuto">
      <slot />
      {
        showSharedSections && (
          <>
            <Newsletter />
            <Testimonials />
          </>
        )
      }
      {showContactBand && <ContactMapBand />}
    </main>
    <SiteFooter />
    <DiscountPopup />
    <CookieBanner />
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
